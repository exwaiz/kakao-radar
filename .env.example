# Use a random URL-safe password. Copy to .env (ignored by Git).
RADAR_DB_PASSWORD=replace-with-random-url-safe-password
# M3 stays disabled. 'extractive' enables only the offline reference provider.
RADAR_ANALYSIS_PROVIDER=disabled
# M4 remains disabled until a channel, schedule and daily limit are configured.
RADAR_DELIVERY_PROVIDER=disabled
# Use a protected ntfy topic with an access token; values are kept off the repository.
RADAR_NTFY_URL=
RADAR_NTFY_TOPIC=
RADAR_NTFY_TOKEN=
# Optional phone digest/feedback links: HTTPS root reachable by the main phone.
# Set both values on API and delivery worker. Use a random secret with 32+ characters.
RADAR_PUBLIC_URL=
RADAR_DIGEST_LINK_SECRET=
